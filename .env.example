# ─── Formulario de contacto (Resend) ───
# Obligatorio para que el formulario envíe correo a nathanholender@gmail.com.
# Crea tu key gratis en https://resend.com/api-keys
RESEND_API_KEY=

# Remitente. Por defecto usa el sandbox de Resend (onboarding@resend.dev), que
# SOLO entrega al correo verificado de la cuenta. Para producción, verifica un
# dominio en Resend y pon algo como: Portafolio <hola@tudominio.com>
RESEND_FROM=

# URL pública del sitio (para metadata, canonical, sitemap y Open Graph).
NEXT_PUBLIC_SITE_URL=https://nathanholender.com
